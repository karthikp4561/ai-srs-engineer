# =================================================================
# AI SRS Engineer - Server Environment Configuration Template
# =================================================================
# Copy this file to .env before starting docker-compose:
#   cp .env.example .env
# Then update with your actual credentials and API keys.

# -----------------
# PostgreSQL Database
# -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=ai_srs_engineer

# -----------------
# Security & JWT
# -----------------
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_jwt_secret_key_12345

# -----------------
# Cryptography Encryption Key (Fernet 32-byte url-safe base64)
# -----------------
# Generate with python: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=ikfYHQNmaE-046oNHXSgA9HWTRf9oV9vQ-dy7TaoJqQ=

# -----------------
# AI / LLM Provider Key (Groq)
# -----------------
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# -----------------
# CORS Allowed Origins
# -----------------
# Use * or comma-separated list of origins, e.g.:
# ALLOWED_ORIGINS=http://your-server-ip,https://yourdomain.com
ALLOWED_ORIGINS=*
